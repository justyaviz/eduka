EDUKA_VERSION=32.4.1
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB
BASE_DOMAIN=eduka.uz
STUDENT_WEBAPP_URL=https://eduka.uz/student-app
SUPER_ADMIN_EMAIL=yaviz@eduka.uz
SUPER_ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_20_CHAR_PASSWORD
SUPER_ADMIN_PHONE=+998200049899
STUDENT_APP_SESSION_SECRET=CHANGE_THIS_RANDOM_32_CHARS
TELEGRAM_WEBHOOK_SECRET=CHANGE_THIS_RANDOM_32_CHARS
LANDING_BOT_TOKEN=
LANDING_CHAT_ID=
STUDENT_BOT_TOKEN=
# Safety: deploy migration never deletes tenant data unless you explicitly allow it.
EDUKA_ALLOW_OWNER_RESET=0
ASSET_UPLOAD_FALLBACK=off

# Eduka AI Assistant — real LLM mode
OPENAI_API_KEY=
AI_ASSISTANT_LLM_ENABLED=true
AI_ASSISTANT_PROVIDER=openai
AI_ASSISTANT_MODEL=gpt-5.5-mini
AI_ASSISTANT_TEMPERATURE=0.4
AI_ASSISTANT_MAX_OUTPUT_TOKENS=650
AI_ASSISTANT_LANGUAGE=uz

# Production protection
EDUKA_RATE_LIMIT_ENABLED=1
EDUKA_API_RATE_LIMIT_PER_MINUTE=240
EDUKA_STRICT_ENV=1
